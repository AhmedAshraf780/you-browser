{
  "name": "unibrowser",
  "version": "0.1.0",
  "description": "Unified browser + notes shell: web, markdown, excalidraw, pdf in one tab bar",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron out/main/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fix-electron": "node scripts/fix-electron.cjs",
    "postinstall": "node scripts/fix-electron.cjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@excalidraw/excalidraw": "^0.18.0",
    "@ghostery/adblocker": "^2.20.1",
    "@ghostery/adblocker-electron": "^2.20.1",
    "@lezer/highlight": "^1.2.5",
    "@uiw/codemirror-themes": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "chokidar": "^3.6.0",
    "marked": "^12.0.0",
    "pdfjs-dist": "^4.2.67",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-vite": "^2.1.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  },
  "allowScripts": {
    "electron@30.5.1": true,
    "esbuild@0.21.5": true
  }
}
