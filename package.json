{
  "name": "unibrowser",
  "version": "0.1.0",
  "description": "Unified browser + notes shell: web, markdown, excalidraw, pdf in one tab bar",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "predev": "node scripts/sync-vditor.mjs",
    "build": "electron-vite build",
    "prebuild": "node scripts/sync-vditor.mjs",
    "preview": "electron-vite preview",
    "start": "electron out/main/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:wallpaper": "node scripts/verify-wallpaper.mjs",
    "verify:fonts": "node scripts/verify-fonts.mjs",
    "fix-electron": "node scripts/fix-electron.cjs",
    "sync-pdfjs": "node scripts/sync-pdfjs.cjs",
    "postinstall": "node scripts/fix-electron.cjs && node scripts/sync-pdfjs.cjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@excalidraw/excalidraw": "0.18.0-43a92e6",
    "@fluent/bundle": "^0.19.1",
    "@fluent/dom": "^0.10.2",
    "@ghostery/adblocker": "^2.20.1",
    "@ghostery/adblocker-electron": "^2.20.1",
    "@lezer/highlight": "^1.2.5",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@replit/codemirror-vim": "^6.4.0",
    "@uiw/codemirror-themes": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "cached-iterable": "^0.3.0",
    "chokidar": "^3.6.0",
    "lucide-react": "^1.57.0",
    "marked": "^12.0.0",
    "pdfjs-dist": "^4.2.67",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vditor": "^4.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.1.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  },
  "allowScripts": {
    "electron@30.5.1": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true,
    "@lydell/node-pty@1.2.0-beta.15": true
  },
  "build": {
    "appId": "com.unibrowser.app",
    "productName": "You",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/chokidar/**/*",
      "node_modules/anymatch/**/*",
      "node_modules/braces/**/*",
      "node_modules/glob-parent/**/*",
      "node_modules/is-binary-path/**/*",
      "node_modules/is-glob/**/*",
      "node_modules/is-extglob/**/*",
      "node_modules/normalize-path/**/*",
      "node_modules/readdirp/**/*",
      "node_modules/micromatch/**/*",
      "node_modules/picomatch/**/*",
      "node_modules/fill-range/**/*",
      "node_modules/to-regex-range/**/*",
      "node_modules/is-number/**/*",
      "node_modules/binary-extensions/**/*",
      "node_modules/@ghostery/**/*",
      "node_modules/@remusao/**/*",
      "node_modules/tldts-experimental/**/*",
      "node_modules/tldts-core/**/*",
      "node_modules/@lydell/**/*",
      "!node_modules/@excalidraw/**/*",
      "!node_modules/@codemirror/**/*",
      "!node_modules/codemirror/**/*",
      "!node_modules/@lezer/**/*",
      "!node_modules/@uiw/**/*",
      "!node_modules/@xterm/**/*",
      "!node_modules/react/**/*",
      "!node_modules/react-dom/**/*",
      "!node_modules/scheduler/**/*",
      "!node_modules/use-sync-external-store/**/*",
      "!node_modules/marked/**/*",
      "!node_modules/zustand/**/*",
      "!node_modules/pdfjs-dist/**/*",
      "!node_modules/d3*/**/*",
      "!node_modules/cytoscape*/**/*",
      "!node_modules/@cytoscape/**/*",
      "!node_modules/mermaid*/**/*",
      "!node_modules/katex/**/*",
      "!node_modules/roughjs/**/*",
      "!node_modules/perfect-freehand/**/*",
      "!node_modules/nanoid/**/*",
      "!node_modules/pica/**/*",
      "!node_modules/sass/**/*",
      "!node_modules/chevrotain*/**/*",
      "!node_modules/@chevrotain/**/*",
      "!node_modules/@braintree/**/*",
      "!node_modules/@floating-ui/**/*",
      "!node_modules/radix-ui/**/*",
      "!node_modules/@radix-ui/**/*",
      "!node_modules/react-remove-scroll*/**/*",
      "!node_modules/react-style-singleton/**/*",
      "!node_modules/aria-hidden/**/*",
      "!node_modules/stylis/**/*",
      "!node_modules/@emotion/**/*",
      "!node_modules/tinyexec/**/*",
      "!node_modules/@antfu/**/*",
      "!node_modules/package-manager-detector/**/*",
      "!node_modules/vscode*/**/*",
      "!node_modules/w3c-keyname/**/*",
      "!node_modules/webworkify/**/*",
      "!node_modules/style-mod/**/*",
      "!node_modules/crelt/**/*",
      "!node_modules/points-on-*/**/*",
      "!node_modules/robust-predicates/**/*",
      "!node_modules/pwacompat/**/*",
      "!node_modules/canvas-roundrect-polyfill/**/*",
      "!node_modules/clsx/**/*",
      "!node_modules/commander/**/*",
      "!node_modules/cross-env/**/*",
      "!node_modules/cross-spawn/**/*",
      "!node_modules/shebang-command/**/*",
      "!node_modules/shebang-regex/**/*",
      "!node_modules/path-key/**/*",
      "!node_modules/which/**/*",
      "!node_modules/@types/**/*",
      "!node_modules/@iconify/**/*",
      "!node_modules/@marijn/**/*",
      "!node_modules/@mermaid-js/**/*",
      "!node_modules/@napi-rs/**/*",
      "!node_modules/@upsetjs/**/*",
      "!node_modules/browser-fs-access/**/*",
      "!node_modules/cose-base/**/*",
      "!node_modules/dagre-d3-es/**/*",
      "!node_modules/dayjs/**/*",
      "!node_modules/delaunator/**/*",
      "!node_modules/detect-node-es/**/*",
      "!node_modules/dompurify/**/*",
      "!node_modules/es-toolkit/**/*",
      "!node_modules/es6-promise-pool/**/*",
      "!node_modules/fastdom/**/*",
      "!node_modules/fuzzy/**/*",
      "!node_modules/get-nonce/**/*",
      "!node_modules/glur/**/*",
      "!node_modules/hachure-fill/**/*",
      "!node_modules/iconv-lite/**/*",
      "!node_modules/image-blob-reduce/**/*",
      "!node_modules/immutable/**/*",
      "!node_modules/import-meta-resolve/**/*",
      "!node_modules/inherits/**/*",
      "!node_modules/internmap/**/*",
      "!node_modules/js-tokens/**/*",
      "!node_modules/khroma/**/*",
      "!node_modules/langium/**/*",
      "!node_modules/layout-base/**/*",
      "!node_modules/lodash-es/**/*",
      "!node_modules/lodash.debounce/**/*",
      "!node_modules/lodash.throttle/**/*",
      "!node_modules/loose-envify/**/*",
      "!node_modules/multimath/**/*",
      "!node_modules/object-assign/**/*",
      "!node_modules/pako/**/*",
      "!node_modules/path-data-parser/**/*",
      "!node_modules/png-chunk-text/**/*",
      "!node_modules/png-chunks-encode/**/*",
      "!node_modules/png-chunks-extract/**/*",
      "!node_modules/robust-predicates/**/*",
      "!node_modules/rw/**/*",
      "!node_modules/safer-buffer/**/*",
      "!node_modules/sliced/**/*",
      "!node_modules/source-map-js/**/*",
      "!node_modules/strictdom/**/*",
      "!node_modules/tinycolor2/**/*",
      "!node_modules/ts-dedent/**/*",
      "!node_modules/tunnel-rat/**/*",
      "!node_modules/use-callback-ref/**/*",
      "!node_modules/use-sidecar/**/*",
      "!node_modules/uuid/**/*",
      "!node_modules/crc-32/**/*",
      "!node_modules/detect-node-es/**/*",
      "!node_modules/inherits/**/*",
      "!node_modules/isexe/**/*",
      "!node_modules/jotai*/**/*"
    ],
    "npmRebuild": false,
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network"
    }
  }
}
